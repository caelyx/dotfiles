FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    zsh \
    git \
    curl \
    wget \
    ripgrep \
    fd-find \
    jq \
    tree \
    htop \
    unzip \
    ca-certificates \
    openssh-client \
    vim-nox \
    fzf \
    && rm -rf /var/lib/apt/lists/*

# Python
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Node
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Non-root user with zsh as default shell
ARG USERNAME=agent
ARG USER_UID=1000
ARG USER_GID=$USER_UID
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/zsh $USERNAME \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Create symlinks to dotfiles (actual files are mounted at runtime)
RUN ln -s /home/agent/.dotfiles/zshrc /home/agent/.zshrc && \
    ln -s /home/agent/.dotfiles/vimrc /home/agent/.vimrc && \
    ln -s /home/agent/.dotfiles/gitconfig /home/agent/.gitconfig

WORKDIR /workspace
USER $USERNAME

LABEL maintainer="simon"
LABEL purpose="agentic-sandbox-base"
